# Used by the AI tutor (app_package/tutor.py). Loaded via python-dotenv.
# The tutor uses Gemini when GEMINI_API_KEY is filled in, otherwise OpenAI.
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# The tutor's Jais 3 options (local-llm.md): the home PC's llama-server and its --api-key
LOCAL_LLM_URL=https://llm.jasem.dev/v1/chat/completions
LOCAL_LLM_KEY=your_llama_server_api_key_here
